<Window x:Class="ASM2_HE194435.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ASM2_HE194435"
        mc:Ignorable="d"
        Title="ProjectWindow" Height="580" Width="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Current Project" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Project ID:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtProjectId" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="5" Height="25" VerticalContentAlignment="Center"/>

                <Label Content="Project Name:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtProjectName" Grid.Row="0" Grid.Column="3" Margin="5" Height="25" VerticalContentAlignment="Center"/>

                <Label Content="Start Date:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpStartDate" Grid.Row="1" Grid.Column="1" Margin="5" Height="25" VerticalContentAlignment="Center"/>

                <Label Content="Type:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                <ComboBox x:Name="cboType" Grid.Row="1" Grid.Column="3" Margin="5" Height="25" VerticalContentAlignment="Center" SelectionChanged="cboType_SelectionChanged"/>

                <Label Content="Department:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox x:Name="cboDepartment" Grid.Row="2" Grid.Column="1" Margin="5" Height="25" VerticalContentAlignment="Center" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <Label Content="Description:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDescription" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="btnAdd" Content="Add" Width="80" Height="28" Margin="5" Click="btnAdd_Click"/>
            <Button x:Name="btnEdit" Content="Edit" Width="80" Height="28" Margin="5" Click="btnEdit_Click"/>
            <Button x:Name="btnDelete" Content="Delete" Width="80" Height="28" Margin="5" Click="btnDelete_Click"/>
            <Button x:Name="btnClose" Content="Close" Width="80" Height="28" Margin="5" Click="btnClose_Click"/>
        </StackPanel>

        <GroupBox Header="Project List" Grid.Row="2" Padding="5">
            <DataGrid x:Name="dgProjects"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="dgProjects_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project ID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Project Name" Binding="{Binding Name}" Width="170"/>
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding DepartmentNavigation.Name}" Width="120"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
